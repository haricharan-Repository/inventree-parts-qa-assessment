# Copy to .env and adjust for your InvenTree instance.
# Default values match a fresh `docker compose up` InvenTree install.

BASE_URL=http://localhost:8000
INVENTREE_USERNAME=admin
INVENTREE_PASSWORD=inventree

# A second, read-only account used by API-E-03 (insufficient permission).
# Create this user in InvenTree admin before running that test, or it will be skipped.
READONLY_USERNAME=
READONLY_PASSWORD=
